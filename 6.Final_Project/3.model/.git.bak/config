[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
	ignorecase = true
	precomposeunicode = true
[remote "origin"]
	url = git@github.com:100-hours-a-week/9-team-Devths-AI.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
